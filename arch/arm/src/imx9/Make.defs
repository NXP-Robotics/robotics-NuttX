include armv7-m/Make.defs

# i.MX9-specific C source files

CHIP_CSRCS = imx9_allocateheap.c imx9_start.c imx9_clockconfig.c imx9_gpio.c imx9_iomuxc.c imx9_irq.c imx9_timerisr.c imx9_idle.c

ifeq ($(CONFIG_IMX9_SCMI),y)
  CHIP_CSRCS += imx9_scmi.c
  # NXP SDK SCMI interface for pinctrl and clocking
endif

ifeq ($(CONFIG_RPTUN),y)
  CHIP_CSRCS += imx9_rsctable.c imx9_rptun.c
endif

ifeq ($(CONFIG_IMX9_MU),y)
  CHIP_CSRCS += imx9_mu.c
endif

ifeq ($(CONFIG_ARM_MPU),y)
CHIP_CSRCS += imx9_mpuinit.c
endif

ifeq ($(CONFIG_IMX9_FLEXCAN),y)
  CHIP_CSRCS += imx9_flexcan.c
endif

ifeq ($(CONFIG_IMX9_SAR_ADC),y)
  CHIP_CSRCS += imx9_sar_adc.c
endif

ifeq ($(CONFIG_IMX9_LPUART),y)
  CHIP_CSRCS += imx9_lpuart.c imx9_lowputc.c
endif

ifeq ($(CONFIG_IMX9_GPIO_IRQ),y)
  CHIP_CSRCS += imx9_gpioirq.c
endif

ifeq ($(CONFIG_IMX9_FLEXIO),y)
  CHIP_CSRCS += imx9_flexio.c
endif

ifeq ($(CONFIG_IMX9_TPM_PWM),y)
  CHIP_CSRCS += imx9_tpm_pwm.c
endif

ifeq ($(CONFIG_IMX9_USBDEV),y)
  CHIP_CSRCS += imx9_usbdev.c
endif

ifeq ($(CONFIG_IMX9_LPI2C),y)
  CHIP_CSRCS += imx9_lpi2c.c
endif

ifeq ($(CONFIG_IMX9_LPSPI), y)
  CHIP_CSRCS += imx9_lpspi.c
endif

ifeq ($(CONFIG_IMX9_EDMA), y)
  CHIP_CSRCS += imx9_edma.c
endif

ifeq ($(CONFIG_IMX9_MSGINTR), y)
  CHIP_CSRCS += imx9_msgintr.c
endif

ifeq ($(CONFIG_IMX9_NETC_VSI), y)
  CHIP_CSRCS += imx9_netc_msg.c imx9_netc_vsi.c
endif

ifeq ($(CONFIG_IMX9_NETC_VSI), y)
  CFLAGS += -I$(ARCH_SRCDIR)/chip/nxp_sdk/netc
  CFLAGS += -I$(ARCH_SRCDIR)/chip/nxp_sdk
  CFLAGS += -DCPU_MIMX9594AVZXN_cm7
  CFLAGS += -DFSL_FEATURE_NETC_HAS_NO_XGMII=1
  CFLAGS += -DFSL_FEATURE_NETC_HAS_NO_SWITCH=1
  CFLAGS += -DSDK_DEVICE_MAXIMUM_CPU_CLOCK_FREQUENCY=800000000U
  CFLAGS += -include $(ARCH_SRCDIR)/chip/nxp_sdk/MIMX9594_cm7_COMMON.h
  CHIP_CSRCS += nxp_sdk/netc/fsl_netc_endpoint.c
  CHIP_CSRCS += nxp_sdk/netc/fsl_netc_msg.c
  CHIP_CSRCS += nxp_sdk/netc/fsl_netc_soc.c
  CHIP_CSRCS += nxp_sdk/netc/netc_hw/fsl_netc_hw.c
  CHIP_CSRCS += nxp_sdk/netc/netc_hw/fsl_netc_hw_enetc.c
  CHIP_CSRCS += nxp_sdk/netc/netc_hw/fsl_netc_hw_port.c
  CHIP_CSRCS += nxp_sdk/netc/netc_hw/fsl_netc_hw_si.c

  # Ensure output subdirectories exist before the compiler tries to write .o files.
  $(shell mkdir -p nxp_sdk/netc/netc_hw)
endif
